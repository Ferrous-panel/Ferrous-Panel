# FerrousPanel Runtime Environment Configuration (/etc/ferrous-panel/panel.env)
# Note: Admin password is NEVER passed via env vars or CLI flags; it is generated
# once via OsRng on first run and stored as an Argon2id hash (mode 0600).

# Default bind is loopback-only (127.0.0.1). Only expose publicly with TLS/reverse proxy
# or explicit --bind; set FERROUS_SECURE_COOKIE=true whenever accessed over HTTPS.
FERROUS_MODE=production
FERROUS_BIND=127.0.0.1
FERROUS_PORT=8443
FERROUS_DATA_DIR=/var/lib/ferrous-panel
FERROUS_WWWROOT=/www/wwwroot
FERROUS_BACKUPS_DIR=/var/backups/ferrous-panel
FERROUS_SYSTEMD_DIR=/etc/systemd/system
FERROUS_ADMIN_USER=admin_ferrous
FERROUS_SECURITY_ENTRANCE=/panel
FERROUS_CUSTOM_DOMAIN=
FERROUS_SECURE_COOKIE=true
RUST_LOG=info,actix_web=info
